{
  "expo": {
    "name": "PROPOSTA JÁ",
    "slug": "proposta-ja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "propostaja",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.0",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.propostaja.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Selecionar a logo da sua empresa",
        "NSCameraUsageDescription": "Capturar a logo da sua empresa",
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.propostaja.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita acesso para selecionar a logo da empresa",
          "cameraPermission": "Permita acesso para capturar a logo da empresa"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0F172A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "f53c1bf3-4a53-41b4-8484-cc1020fecc99"
      }
    },

    "updates": {
      "url": "https://u.expo.dev/f53c1bf3-4a53-41b4-8484-cc1020fecc99"
    }
  }
}