{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/accept/:id", "destination": "/accept/[id].html" },
    { "source": "/proposal/:id", "destination": "/proposal/[id].html" },
    { "source": "/p/:code", "destination": "/p/[code].html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
