{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/accept/:id", "destination": "/accept/%5Bid%5D" },
    { "source": "/proposal/:id", "destination": "/proposal/%5Bid%5D" },
    { "source": "/p/:code", "destination": "/p/%5Bcode%5D" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
