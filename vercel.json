{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/proposals", "destination": "/index.html" },
    { "source": "/accept/:id", "destination": "/index.html" },
    { "source": "/proposal/:id", "destination": "/index.html" },
    { "source": "/p/:code", "destination": "/index.html" },
    { "source": "/((?!_expo/|assets/|favicon.ico|.*\\.).*)", "destination": "/index.html" }
  ]
}
